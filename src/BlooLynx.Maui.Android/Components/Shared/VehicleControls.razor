@implements IDisposable
@using BlooLynx
@using BlooLynx.Maui.Android.Models
@using BlooLynx.Models
@inject StateService StateService
@inject NavigationManager Navigation

@if (Status is not null && Vehicle is not null)
{
    <div class="d-flex justify-content-center text-center">
        <div class="mx-4">
            <h1 class="mb-1">@((Vehicle.VehicleConfig.IsEV ? Status.DriveTrain.StateOfCharge : Status.DriveTrain.FuelLevel)?.ToString() ?? "unknown")%</h1>
            <div class="small text-capitalize">@(Vehicle.VehicleConfig.IsEV ? "Charge" : "Fuel")</div>
        </div>
        @if (Vehicle.VehicleConfig.IsEV)
        {
            <div class="mx-4" role="button" style="cursor: pointer;" @onclick="ToggleRangeDisplay">
                <h1 class="mb-1">@RangeDisplayText</h1>
                <div class="small text-capitalize">@(StateService.ShowEstimatedRange ? "Estimated Range" : "Reported Range")</div>
            </div>
        }
        else
        {
            <div class="mx-4">
                <h1 class="mb-1">@RangeDisplayText</h1>
                <div class="small text-capitalize">Range</div>
            </div>
        }
    </div>

    <div class="justify-content-center d-flex align-items-center my-2" style="min-height: 1.5rem;">
        @ChargingStatusText
    </div>

    <div class="d-flex justify-content-center gap-3 my-3">
        @if (!IsHideNonCharging)
        {
            <button class="btn @(Status.ClosurePanels.Locked ? "btn-success" : "btn-danger") @(_busyAction == VehicleAction.Lock ? "heartbeat" : "")" type="button" @onclick="ToggleLockAsync" disabled="@(_isPerformingAction || IsBusy)">
                @((MarkupString)(Status.ClosurePanels.Locked ? LockFillSvg : UnlockFillSvg))
            </button>
        }
        @if (Vehicle.VehicleConfig.IsEV)
        {
            var isCharging = Status.DriveTrain.IsCharging ?? false;
            var isPluggedIn = Status.DriveTrain.PluggedTo is not null and not EvPlugType.Unplugged;
            <button class="btn @(isCharging ? "charging-active" : "btn-secondary") @(_busyAction == VehicleAction.Charge ? "heartbeat" : "")" type="button" @onclick="ToggleChargeAsync" disabled="@(_isPerformingAction || IsBusy || (!isCharging && !isPluggedIn))">
                @((MarkupString)(isCharging ? LightningChargeFillSvg : LightningChargeSvg))
            </button>
        }
        @if (!IsHideNonCharging)
        {
            <button class="btn @(Status.Climate.Active ? "" : "btn-secondary") @(_busyAction == VehicleAction.Climate ? "heartbeat" : Status.Climate.Active ? "climate-on" : "")" type="button" @onclick="ToggleClimateAsync" disabled="@(_isPerformingAction || IsBusy)">
                @((MarkupString)FanSvg)
            </button>
        }
    </div>

    @if (_actionError is not null)
    {
        <p class="text-danger small text-center">@_actionError</p>
    }
}

<PinModal @bind-IsOpen="_pinModalOpen" IsBusy="_isPerformingAction" ErrorMessage="@_pinError" OnSubmit="HandlePinSubmittedAsync" OnCancel="HandlePinCancelled" />

@code {
    private const string LockFillSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 0a4 4 0 0 1 4 4v2.05a2.5 2.5 0 0 1 2 2.45v5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 13.5v-5a2.5 2.5 0 0 1 2-2.45V4a4 4 0 0 1 4-4m0 1a3 3 0 0 0-3 3v2h6V4a3 3 0 0 0-3-3"/></svg>""";

    private const string UnlockFillSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M12 0a4 4 0 0 1 4 4v2.5h-1V4a3 3 0 1 0-6 0v2h.5A2.5 2.5 0 0 1 12 8.5v5A2.5 2.5 0 0 1 9.5 16h-7A2.5 2.5 0 0 1 0 13.5v-5A2.5 2.5 0 0 1 2.5 6H8V4a4 4 0 0 1 4-4"/></svg>""";

    private const string LightningChargeFillSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09z"/></svg>""";

    private const string LightningChargeSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09zM4.157 8.5H7a.5.5 0 0 1 .478.647L6.11 13.59l5.732-6.09H9a.5.5 0 0 1-.478-.647L9.89 2.41z"/></svg>""";

    private const string FanSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path d="M10 3c0 1.313-.304 2.508-.8 3.4a2 2 0 0 0-1.484-.38c-.28-.982-.91-2.04-1.838-2.969a8 8 0 0 0-.491-.454A6 6 0 0 1 8 2c.691 0 1.355.117 1.973.332Q10 2.661 10 3m0 5q0 .11-.012.217c1.018-.019 2.2-.353 3.331-1.006a8 8 0 0 0 .57-.361 6 6 0 0 0-2.53-3.823 9 9 0 0 1-.145.64c-.34 1.269-.944 2.346-1.656 3.079.277.343.442.78.442 1.254m-.137.728a2 2 0 0 1-1.07 1.109c.525.87 1.405 1.725 2.535 2.377q.3.174.605.317a6 6 0 0 0 2.053-4.111q-.311.11-.641.199c-1.264.339-2.493.356-3.482.11ZM8 10c-.45 0-.866-.149-1.2-.4-.494.89-.796 2.082-.796 3.391q0 .346.027.678A6 6 0 0 0 8 14c.94 0 1.83-.216 2.623-.602a8 8 0 0 1-.497-.458c-.925-.926-1.555-1.981-1.836-2.96Q8.149 10 8 10M6 8q0-.12.014-.239c-1.02.017-2.205.351-3.34 1.007a8 8 0 0 0-.568.359 6 6 0 0 0 2.525 3.839 8 8 0 0 1 .148-.653c.34-1.267.94-2.342 1.65-3.075A2 2 0 0 1 6 8m-3.347-.632c1.267-.34 2.498-.355 3.488-.107.196-.494.583-.89 1.07-1.1-.524-.874-1.406-1.733-2.541-2.388a8 8 0 0 0-.594-.312 6 6 0 0 0-2.06 4.106q.309-.11.637-.199M8 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/></svg>""";

    private enum VehicleAction
    {
        Lock,
        Charge,
        Climate,
    }

    /// <summary>The vehicle this panel controls. Owned by the host page — set once when a vehicle is selected.</summary>
    [Parameter, EditorRequired]
    public Vehicle? Vehicle { get; set; }

    /// <summary>The current status. Two-way bound so the host page's own copy (used for other UI, like Home's
    /// nav-list rows) stays in sync whenever this panel refreshes it after an action or the charging poll.</summary>
    [Parameter, EditorRequired]
    public Status? Status { get; set; }

    [Parameter]
    public EventCallback<Status?> StatusChanged { get; set; }

    /// <summary>When true, hides the lock and climate buttons, leaving only charge — used on the dedicated
    /// Charging page, which has nothing to do with the vehicle's locks or climate.</summary>
    [Parameter]
    public bool IsHideNonCharging { get; set; }

    /// <summary>Two-way bound: this panel sets it (and notifies via <see cref="IsBusyChanged"/>) while one of its
    /// own commands is in flight, so the host page can disable its own controls (e.g. a refresh button) too. It
    /// also works in reverse — the host can set it while ITS OWN unrelated command is running (e.g. the Charging
    /// page's charge-limit sliders), which disables this panel's lock/charge/climate buttons in turn.</summary>
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback<bool> IsBusyChanged { get; set; }

    private VehicleAction? _pendingAction;
    private VehicleAction? _busyAction;
    private bool _isPerformingAction;
    private bool _pinModalOpen;
    private string? _pinError;
    private string? _actionError;
    private Timer? _chargeRefreshTimer;
    private Vehicle? _settingsLoadedForVehicle;
    private VehicleSettings? _vehicleSettings;

    /// <summary>The reported range (as returned by the API) or an estimate computed from the config page's
    /// battery capacity/efficiency figures and the current state of charge, depending on
    /// <see cref="StateService.ShowEstimatedRange"/>. "---" stands in for any figure that isn't available, rather
    /// than a raw number turning misleading (e.g. a stale reported range shown right after the config values are
    /// entered but before a fresh status fetch). Non-EVs always show the reported figure regardless of the saved
    /// preference — there's no config page or toggle for them to have set it through, and the estimate's inputs
    /// (state of charge, battery capacity) don't apply to a gas tank anyway.</summary>
    private string RangeDisplayText
    {
        get
        {
            if (Status is null)
            {
                return "---";
            }

            var unitSuffix = Status.DriveTrain.RangeUnit == DistanceUnit.Kilometers ? "km" : "mi";

            if (!StateService.ShowEstimatedRange || Vehicle?.VehicleConfig.IsEV != true)
            {
                return $"{Status.DriveTrain.Range} {unitSuffix}";
            }

            var estimated = EstimatedRangeDistance;
            return estimated is null ? "---" : $"{estimated.Value:0} {unitSuffix}";
        }
    }

    /// <summary>Battery capacity (kWh) times state of charge times efficiency — null if any of the three isn't
    /// available, e.g. the vehicle isn't an EV or the config page hasn't been filled in yet. The efficiency
    /// figure is whatever unit the config page's own field was labeled with (miles or km per kW, matching the
    /// vehicle's reported range unit), so this multiplication needs no separate unit conversion — the result is
    /// already in the same unit <see cref="RangeDisplayText"/> labels it with.</summary>
    private double? EstimatedRangeDistance
    {
        get
        {
            var capacity = _vehicleSettings?.BatteryCapacityKwh;
            var efficiency = _vehicleSettings?.EfficiencyMilesPerKwh;
            var soc = Status?.DriveTrain.StateOfCharge;
            if (capacity is null || efficiency is null || soc is null)
            {
                return null;
            }

            return capacity.Value * (soc.Value / 100.0) * efficiency.Value;
        }
    }

    private string ChargingStatusText
    {
        get
        {
            if (Status is null || !(Status.DriveTrain.IsCharging ?? false))
            {
                return string.Empty;
            }

            var minutes = Status.DriveTrain.EstimatedCurrentChargeDuration;
            if (minutes is null)
            {
                return string.Empty;
            }

            var total = (int)minutes.Value;
            if (total <= 0)
            {
                return "Calculating time remaining";
            }

            return $"{total / 60}:{total % 60:00} remaining";
        }
    }

    /// <summary>Starts or stops the once-a-minute background poll based on the current charging flag, and — the
    /// first time a given <see cref="Vehicle"/> is seen — loads its config-page battery/efficiency settings for
    /// <see cref="EstimatedRangeDistance"/>. Called whenever <see cref="Status"/> could have changed (parameters
    /// set, and after this panel's own refreshes).</summary>
    protected override async Task OnParametersSetAsync()
    {
        UpdateChargeRefreshTimer();

        if (Vehicle is not null && !ReferenceEquals(Vehicle, _settingsLoadedForVehicle))
        {
            _settingsLoadedForVehicle = Vehicle;
            _vehicleSettings = await StateService.GetVehicleSettingsAsync(Vehicle);
        }
    }

    private Task ToggleRangeDisplay() => StateService.SetShowEstimatedRangeAsync(!StateService.ShowEstimatedRange);

    private async Task SetBusyAsync(bool value)
    {
        _isPerformingAction = value;
        IsBusy = value;
        await IsBusyChanged.InvokeAsync(value);
    }

    private async Task ToggleLockAsync()
    {
        if (Vehicle is null || Status is null)
        {
            return;
        }

        _pendingAction = VehicleAction.Lock;

        if (!StateService.HasPin)
        {
            OpenPinModal();
            return;
        }

        await PerformLockToggleAsync(pinAlreadyConfirmed: true);
    }

    private async Task ToggleChargeAsync()
    {
        if (Vehicle is null || Status is null)
        {
            return;
        }

        _pendingAction = VehicleAction.Charge;

        if (!StateService.HasPin)
        {
            OpenPinModal();
            return;
        }

        await PerformChargeToggleAsync(pinAlreadyConfirmed: true);
    }

    /// <summary>Tapping the fan button while climate is running stops it directly (same PIN-gated convention as
    /// lock/charge). While it's off, tapping instead navigates to the climate page to pick a temperature and
    /// start it — there's no "start" action here.</summary>
    private async Task ToggleClimateAsync()
    {
        if (Vehicle is null || Status is null)
        {
            return;
        }

        if (!Status.Climate.Active)
        {
            Navigation.NavigateTo("/climate");
            return;
        }

        _pendingAction = VehicleAction.Climate;

        if (!StateService.HasPin)
        {
            OpenPinModal();
            return;
        }

        await PerformClimateStopAsync(pinAlreadyConfirmed: true);
    }

    private void OpenPinModal()
    {
        _pinError = null;
        _pinModalOpen = true;
    }

    private async Task HandlePinSubmittedAsync(string pin)
    {
        StateService.SetPendingPin(pin);
        _pinModalOpen = false;

        switch (_pendingAction)
        {
            case VehicleAction.Charge:
                await PerformChargeToggleAsync(pinAlreadyConfirmed: false);
                break;
            case VehicleAction.Climate:
                await PerformClimateStopAsync(pinAlreadyConfirmed: false);
                break;
            default:
                await PerformLockToggleAsync(pinAlreadyConfirmed: false);
                break;
        }
    }

    private void HandlePinCancelled()
    {
        _pinError = null;
    }

    /// <summary>Fires the lock/unlock command and waits for it to actually complete.
    /// <paramref name="pinAlreadyConfirmed"/> distinguishes two failure cases: if the PIN in use had already worked
    /// before this attempt (persisted from a prior success), a failure here isn't evidence the PIN is bad — it's
    /// shown as an inline <see cref="_actionError"/> and the PIN is left alone. Only a PIN that was just typed into
    /// the modal and hasn't proven itself yet gets forgotten and reprompted on failure, since there's no reliable
    /// way to tell a genuinely bad *fresh* PIN apart from any other failure. On success, just flips
    /// <see cref="Status"/>'s lock flag locally rather than re-fetching the whole status (SOC/range haven't
    /// changed), then notifies the host so any other UI reading the same status re-renders.</summary>
    private async Task PerformLockToggleAsync(bool pinAlreadyConfirmed)
    {
        if (Vehicle is null || Status is null)
        {
            return;
        }

        await SetBusyAsync(true);
        _busyAction = VehicleAction.Lock;
        _pinError = null;
        _actionError = null;
        StateHasChanged();

        try
        {
            var wasLocked = Status.ClosurePanels.Locked;
            var commandResult = await StateService.ToggleVehicleLockAsync(Vehicle, wasLocked);
            if (commandResult.IsSuccessful)
            {
                await StateService.ConfirmPinAsync();
                Status.ClosurePanels.Locked = !wasLocked;
                await StatusChanged.InvokeAsync(Status);
                _pinModalOpen = false;
            }
            else if (pinAlreadyConfirmed)
            {
                _actionError = commandResult.ErrorMessage;
            }
            else
            {
                await StateService.ForgetPinAsync();
                _pinError = commandResult.ErrorMessage;
                _pinModalOpen = true;
            }
        }
        finally
        {
            await SetBusyAsync(false);
            _busyAction = null;
            StateHasChanged();
        }
    }

    /// <summary>Fires the charge start/stop command and waits for it to actually complete. Mirrors
    /// <see cref="PerformLockToggleAsync"/>'s PIN handling exactly, including the <paramref name="pinAlreadyConfirmed"/>
    /// distinction — a failure with an already-proven PIN (e.g. the car isn't plugged in) shows an inline
    /// <see cref="_actionError"/> instead of forgetting a perfectly good PIN. On success, re-fetches the whole
    /// status (rather than assuming the flag flipped) since limit/power/duration all depend on what the vehicle
    /// actually did.</summary>
    private async Task PerformChargeToggleAsync(bool pinAlreadyConfirmed)
    {
        if (Vehicle is null || Status is null)
        {
            return;
        }

        await SetBusyAsync(true);
        _busyAction = VehicleAction.Charge;
        _pinError = null;
        _actionError = null;
        StateHasChanged();

        try
        {
            var wasCharging = Status.DriveTrain.IsCharging ?? false;
            var commandResult = await StateService.ToggleVehicleChargeAsync(Vehicle, wasCharging);
            if (commandResult.IsSuccessful)
            {
                await StateService.ConfirmPinAsync();
                await RefreshStatusQuietAsync();
                _pinModalOpen = false;
            }
            else if (pinAlreadyConfirmed)
            {
                _actionError = commandResult.ErrorMessage;
            }
            else
            {
                await StateService.ForgetPinAsync();
                _pinError = commandResult.ErrorMessage;
                _pinModalOpen = true;
            }
        }
        finally
        {
            await SetBusyAsync(false);
            _busyAction = null;
            StateHasChanged();
        }
    }

    /// <summary>Fires the climate-stop command and waits for it to actually complete. Mirrors
    /// <see cref="PerformLockToggleAsync"/>'s PIN handling exactly. On success, flips <see cref="Status"/>'s
    /// climate fields locally (both <c>Active</c> and <c>Temperature</c>) rather than re-fetching the whole
    /// status, then notifies the host.</summary>
    private async Task PerformClimateStopAsync(bool pinAlreadyConfirmed)
    {
        if (Vehicle is null || Status is null)
        {
            return;
        }

        await SetBusyAsync(true);
        _busyAction = VehicleAction.Climate;
        _pinError = null;
        _actionError = null;
        StateHasChanged();

        try
        {
            var commandResult = await StateService.StopVehicleClimateAsync(Vehicle);
            if (commandResult.IsSuccessful)
            {
                await StateService.ConfirmPinAsync();
                Status.Climate.Active = false;
                Status.Climate.Temperature = new ClimateTemperature(isOn: false, temperature: 0, Status.Climate.Temperature.Unit);
                await StatusChanged.InvokeAsync(Status);
                _pinModalOpen = false;
            }
            else if (pinAlreadyConfirmed)
            {
                _actionError = commandResult.ErrorMessage;
            }
            else
            {
                await StateService.ForgetPinAsync();
                _pinError = commandResult.ErrorMessage;
                _pinModalOpen = true;
            }
        }
        finally
        {
            await SetBusyAsync(false);
            _busyAction = null;
            StateHasChanged();
        }
    }

    /// <summary>Re-fetches status without a loading flag of its own — used right after a charge start/stop
    /// command (so the button/status line reflect what the vehicle actually reports rather than an assumed flip)
    /// and by the once-a-minute charging poll below.</summary>
    private async Task RefreshStatusQuietAsync()
    {
        if (Vehicle is null)
        {
            return;
        }

        var result = await Vehicle.StatusAsync();
        if (result.IsSuccessful)
        {
            Status = result.Data;
            StateService.CachedStatus = Status;
            await StatusChanged.InvokeAsync(Status);
            UpdateChargeRefreshTimer();
        }

        StateHasChanged();
    }

    private void UpdateChargeRefreshTimer()
    {
        var shouldPoll = Status?.DriveTrain.IsCharging ?? false;

        if (shouldPoll && _chargeRefreshTimer is null)
        {
            _chargeRefreshTimer = new Timer(_ => InvokeAsync(RefreshStatusQuietAsync), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
        }
        else if (!shouldPoll && _chargeRefreshTimer is not null)
        {
            _chargeRefreshTimer.Dispose();
            _chargeRefreshTimer = null;
        }
    }

    public void Dispose()
    {
        _chargeRefreshTimer?.Dispose();
    }
}
