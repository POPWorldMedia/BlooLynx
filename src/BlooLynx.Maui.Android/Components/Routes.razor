@implements IDisposable
@inject StateService StateService

@if (!StateService.IsInitialized)
{
    <div class="vh-100 flex-column d-flex align-items-center justify-content-center">
        <div>Vroom vroom...</div>
        <div class="progress w-75 mt-2">
            <div class="progress-bar progress-bar-striped" role="progressbar" style="width: var(--blazor-load-percentage)"></div>
        </div>
    </div>
}
else if (StateService.IsAuthenticated)
{
    <Router AppAssembly="typeof(MauiProgram).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
}
else
{
    <Login />
}

@code {
    protected override void OnInitialized()
    {
        StateService.StateChanged += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await StateService.InitializeAsync();
        }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        StateService.StateChanged -= HandleStateChanged;
    }
}
