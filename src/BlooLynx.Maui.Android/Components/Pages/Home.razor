@page "/"
@implements IDisposable
@using BlooLynx
@using BlooLynx.Models
@inject StateService StateService

@if (StateService.Vehicles.Count == 0)
{
    <p>You have no vehicles.</p>
}
else
{
    <div class="d-flex align-items-center gap-2 my-3">
        <div class="dropdown">
            <button class="btn btn-secondary @(StateService.Vehicles.Count > 1 ? "dropdown-toggle" : "")" type="button" @onclick="ToggleDropdown" disabled="@(StateService.Vehicles.Count <= 1)">
                @(_selectedVehicle?.VehicleConfig.Nickname ?? "Select a vehicle")
            </button>
            <ul class="dropdown-menu @(_dropdownOpen ? "show" : "")">
                @foreach (var vehicle in StateService.Vehicles)
                {
                    <li>
                        <button class="dropdown-item" type="button" @onclick="() => SelectVehicleAsync(vehicle)">
                            @vehicle.VehicleConfig.Nickname
                        </button>
                    </li>
                }
            </ul>
        </div>
        <button class="btn p-0 border-0 bg-transparent" type="button" @onclick="RefreshAsync" disabled="@(_isLoading || _isPerformingAction)" aria-label="Refresh">
            @((MarkupString)ArrowClockwiseSvg)
        </button>
    </div>
    <p class="small text-capitalize">
        @_selectedVehicle?.VehicleConfig.ModelYear
        @_selectedVehicle?.VehicleConfig.ModelCode
        @_selectedVehicle?.VehicleConfig.Trim
    </p>

    if (_isLoading)
    {
        <div class="d-flex justify-content-center my-3">
            <span class="spinner-border" aria-hidden="true"></span>
        </div>
    }
    else if (_status is not null)
    {
        <div class="d-flex justify-content-center text-center">
            <div class="mx-4">
                <h1 class="mb-1">@((_selectedVehicle!.VehicleConfig.IsEV ? _status.DriveTrain.StateOfCharge : _status.DriveTrain.FuelLevel)?.ToString() ?? "unknown")%</h1>
                <div class="small text-capitalize">@(_selectedVehicle.VehicleConfig.IsEV ? "Charge" : "Fuel")</div>
            </div>
            <div class="mx-4">
                <h1 class="mb-1">@_status.DriveTrain.Range @(_status.DriveTrain.RangeUnit == DistanceUnit.Kilometers ? "km" : "mi")</h1>
                <div class="small text-capitalize">Range</div>
            </div>
        </div>

        <div class="text-center small" style="min-height: 1.25rem;">
            @_chargingStatus
        </div>

        <div class="d-flex justify-content-center gap-3 my-3">
            <button class="btn @(_status.ClosurePanels.Locked ? "btn-success" : "btn-danger") @(_busyAction == VehicleAction.Lock ? "heartbeat" : "")" type="button" @onclick="ToggleLockAsync" disabled="@_isPerformingAction">
                @((MarkupString)(_status.ClosurePanels.Locked ? LockFillSvg : UnlockFillSvg))
            </button>
            @if (_selectedVehicle!.VehicleConfig.IsEV)
            {
                var isCharging = _status.DriveTrain.Charging ?? false;
                var isPluggedIn = _status.DriveTrain.PluggedTo is not null and not EvPlugType.Unplugged;
                <button class="btn @(isCharging ? "btn-success" : "btn-secondary") @(_busyAction == VehicleAction.Charge ? "heartbeat" : "")" type="button" @onclick="ToggleChargeAsync" disabled="@(_isPerformingAction || (!isCharging && !isPluggedIn))">
                    @((MarkupString)(isCharging ? LightningChargeFillSvg : LightningChargeSvg))
                </button>
            }
        </div>

        @if (_actionError is not null)
        {
            <p class="text-danger small text-center">@_actionError</p>
        }

        <p class="mt-5">
            @_selectedVehicle.VehicleConfig.Odometer miles<br/>
            VIN: @_selectedVehicle.VehicleConfig.Vin
        </p>
    }
    else if (_error is not null)
    {
        <p>@_error</p>
    }

    @if (_pinModalOpen)
    {
        <div class="modal d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Enter PIN</h5>
                    </div>
                    <div class="modal-body">
                        <p>Enter your BlueLink PIN to control the vehicle. It will be saved so you aren't asked again.</p>
                        <input type="password" inputmode="numeric" class="form-control" @bind="_pinInput" @bind:event="oninput" disabled="@_isPerformingAction" />
                        @if (_pinError is not null)
                        {
                            <p class="text-danger small mt-2 mb-0">@_pinError</p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelPinModal" disabled="@_isPerformingAction">Cancel</button>
                        <button type="button" class="btn btn-primary @(_isPerformingAction ? "heartbeat" : "")" @onclick="SubmitPinAsync" disabled="@(_isPerformingAction || string.IsNullOrWhiteSpace(_pinInput))">Submit</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }
}

@code {
    private const string LockFillSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 0a4 4 0 0 1 4 4v2.05a2.5 2.5 0 0 1 2 2.45v5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 13.5v-5a2.5 2.5 0 0 1 2-2.45V4a4 4 0 0 1 4-4m0 1a3 3 0 0 0-3 3v2h6V4a3 3 0 0 0-3-3"/></svg>""";

    private const string UnlockFillSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M12 0a4 4 0 0 1 4 4v2.5h-1V4a3 3 0 1 0-6 0v2h.5A2.5 2.5 0 0 1 12 8.5v5A2.5 2.5 0 0 1 9.5 16h-7A2.5 2.5 0 0 1 0 13.5v-5A2.5 2.5 0 0 1 2.5 6H8V4a4 4 0 0 1 4-4"/></svg>""";

    private const string LightningChargeFillSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09z"/></svg>""";

    private const string LightningChargeSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"><path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09zM4.157 8.5H7a.5.5 0 0 1 .478.647L6.11 13.59l5.732-6.09H9a.5.5 0 0 1-.478-.647L9.89 2.41z"/></svg>""";

    private const string ArrowClockwiseSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/></svg>""";

    private enum VehicleAction
    {
        Lock,
        Charge,
    }

    private Vehicle? _selectedVehicle;
    private Status? _status;
    private string? _error;
    private bool _isLoading;
    private bool _dropdownOpen;
    private bool _isPerformingAction;
    private VehicleAction? _pendingAction;
    private VehicleAction? _busyAction;
    private bool _pinModalOpen;
    private string _pinInput = string.Empty;
    private string? _pinError;
    private string? _actionError;

    /// <summary>Reserved for a future charging-status message; the placeholder it renders into keeps its
    /// height even while this is empty so the button row below it doesn't shift when text appears.</summary>
    private string? _chargingStatus;

    protected override async Task OnInitializedAsync()
    {
        StateService.Resumed += HandleResumed;

        var vehicle = StateService.Vehicles.FirstOrDefault();
        if (vehicle is null)
        {
            return;
        }

        await SelectVehicleAsync(vehicle);
    }

    private void ToggleDropdown()
    {
        _dropdownOpen = !_dropdownOpen;
    }

    /// <summary>Re-fetches the vehicle list and the currently selected vehicle's status — the same refresh
    /// <see cref="StateService.ResumeAsync"/> performs when the app comes back from the background.</summary>
    private Task RefreshAsync() => StateService.ResumeAsync();

    private void HandleResumed()
    {
        InvokeAsync(RefreshStatusAsync);
    }

    private async Task SelectVehicleAsync(Vehicle vehicle)
    {
        _selectedVehicle = vehicle;
        _dropdownOpen = false;
        await RefreshStatusAsync();
    }

    private async Task ToggleLockAsync()
    {
        if (_selectedVehicle is null || _status is null)
        {
            return;
        }

        _pendingAction = VehicleAction.Lock;

        if (!StateService.HasPin)
        {
            OpenPinModal();
            return;
        }

        await PerformLockToggleAsync(pinAlreadyConfirmed: true);
    }

    private async Task ToggleChargeAsync()
    {
        if (_selectedVehicle is null || _status is null)
        {
            return;
        }

        _pendingAction = VehicleAction.Charge;

        if (!StateService.HasPin)
        {
            OpenPinModal();
            return;
        }

        await PerformChargeToggleAsync(pinAlreadyConfirmed: true);
    }

    private void OpenPinModal()
    {
        _pinInput = string.Empty;
        _pinError = null;
        _pinModalOpen = true;
    }

    private async Task SubmitPinAsync()
    {
        if (string.IsNullOrWhiteSpace(_pinInput))
        {
            return;
        }

        StateService.SetPendingPin(_pinInput.Trim());
        _pinModalOpen = false;

        if (_pendingAction == VehicleAction.Charge)
        {
            await PerformChargeToggleAsync(pinAlreadyConfirmed: false);
        }
        else
        {
            await PerformLockToggleAsync(pinAlreadyConfirmed: false);
        }
    }

    /// <summary>Fires the lock/unlock command and waits for it to actually complete.
    /// <paramref name="pinAlreadyConfirmed"/> distinguishes two failure cases: if the PIN in use had already worked
    /// before this attempt (persisted from a prior success), a failure here isn't evidence the PIN is bad — it's
    /// shown as an inline <see cref="_actionError"/> and the PIN is left alone. Only a PIN that was just typed into
    /// the modal and hasn't proven itself yet gets forgotten and reprompted on failure, since there's no reliable
    /// way to tell a genuinely bad *fresh* PIN apart from any other failure. On success, just flips
    /// <see cref="_status"/>'s lock flag locally rather than re-fetching the whole status (SOC/range haven't
    /// changed).</summary>
    private async Task PerformLockToggleAsync(bool pinAlreadyConfirmed)
    {
        if (_selectedVehicle is null || _status is null)
        {
            return;
        }

        _isPerformingAction = true;
        _busyAction = VehicleAction.Lock;
        _pinError = null;
        _actionError = null;
        StateHasChanged();

        try
        {
            var wasLocked = _status.ClosurePanels.Locked;
            var commandResult = await StateService.ToggleVehicleLockAsync(_selectedVehicle, wasLocked);
            if (commandResult.IsSuccessful)
            {
                await StateService.ConfirmPinAsync();
                _status.ClosurePanels.Locked = !wasLocked;
                _pinModalOpen = false;
                _pinInput = string.Empty;
            }
            else if (pinAlreadyConfirmed)
            {
                _actionError = commandResult.ErrorMessage;
            }
            else
            {
                await StateService.ForgetPinAsync();
                _pinError = commandResult.ErrorMessage;
                _pinInput = string.Empty;
                _pinModalOpen = true;
            }
        }
        finally
        {
            _isPerformingAction = false;
            _busyAction = null;
            StateHasChanged();
        }
    }

    /// <summary>Fires the charge start/stop command and waits for it to actually complete. Mirrors
    /// <see cref="PerformLockToggleAsync"/>'s PIN handling exactly, including the <paramref name="pinAlreadyConfirmed"/>
    /// distinction — a failure with an already-proven PIN (e.g. the car isn't plugged in) shows an inline
    /// <see cref="_actionError"/> instead of forgetting a perfectly good PIN. On success, just flips
    /// <see cref="_status"/>'s charging flag locally rather than re-fetching the whole status.</summary>
    private async Task PerformChargeToggleAsync(bool pinAlreadyConfirmed)
    {
        if (_selectedVehicle is null || _status is null)
        {
            return;
        }

        _isPerformingAction = true;
        _busyAction = VehicleAction.Charge;
        _pinError = null;
        _actionError = null;
        StateHasChanged();

        try
        {
            var wasCharging = _status.DriveTrain.Charging ?? false;
            var commandResult = await StateService.ToggleVehicleChargeAsync(_selectedVehicle, wasCharging);
            if (commandResult.IsSuccessful)
            {
                await StateService.ConfirmPinAsync();
                _status.DriveTrain.Charging = !wasCharging;
                _pinModalOpen = false;
                _pinInput = string.Empty;
            }
            else if (pinAlreadyConfirmed)
            {
                _actionError = commandResult.ErrorMessage;
            }
            else
            {
                await StateService.ForgetPinAsync();
                _pinError = commandResult.ErrorMessage;
                _pinInput = string.Empty;
                _pinModalOpen = true;
            }
        }
        finally
        {
            _isPerformingAction = false;
            _busyAction = null;
            StateHasChanged();
        }
    }

    private void CancelPinModal()
    {
        _pinModalOpen = false;
        _pinInput = string.Empty;
        _pinError = null;
    }

    private async Task RefreshStatusAsync()
    {
        if (_selectedVehicle is null)
        {
            return;
        }

        _isLoading = true;
        _error = null;
        _actionError = null;
        _status = null;
        StateHasChanged();

        var result = await _selectedVehicle.StatusAsync();
        if (result.IsSuccessful)
        {
            _status = result.Data;
        }
        else
        {
            _error = "Could not load vehicle status.";
        }

        _isLoading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        StateService.Resumed -= HandleResumed;
    }
}
