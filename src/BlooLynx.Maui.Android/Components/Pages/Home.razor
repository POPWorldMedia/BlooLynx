@page "/"
@implements IDisposable
@using BlooLynx
@using BlooLynx.Models
@inject StateService StateService

@if (StateService.Vehicles.Count == 0)
{
    <p>You have no vehicles.</p>
}
else
{
    <div class="d-flex align-items-center gap-2 my-3">
        <div class="dropdown">
            <button class="btn btn-secondary @(StateService.Vehicles.Count > 1 ? "dropdown-toggle" : "")" type="button" @onclick="ToggleDropdown" disabled="@(StateService.Vehicles.Count <= 1)">
                @(_selectedVehicle?.VehicleConfig.Nickname ?? "Select a vehicle")
            </button>
            <ul class="dropdown-menu @(_dropdownOpen ? "show" : "")">
                @foreach (var vehicle in StateService.Vehicles)
                {
                    <li>
                        <button class="dropdown-item" type="button" @onclick="() => SelectVehicleAsync(vehicle)">
                            @vehicle.VehicleConfig.Nickname
                        </button>
                    </li>
                }
            </ul>
        </div>
        <button class="btn p-0 border-0 bg-transparent" type="button" @onclick="RefreshAsync" disabled="@(_isLoading || _isChildBusy)" aria-label="Refresh">
            @((MarkupString)ArrowClockwiseSvg)
        </button>
    </div>
    <p class="small text-capitalize">
        @_selectedVehicle?.VehicleConfig.ModelYear
        @_selectedVehicle?.VehicleConfig.ModelCode
        @_selectedVehicle?.VehicleConfig.Trim
    </p>

    if (_isLoading)
    {
        <div class="d-flex justify-content-center my-3">
            <span class="spinner-border" aria-hidden="true"></span>
        </div>
    }
    else if (_status is not null)
    {
        <VehicleControls Vehicle="_selectedVehicle" @bind-Status="_status" @bind-IsBusy="_isChildBusy" IsHideNonCharging="false" />

        <ul class="list-group list-group-flush">
            <li class="list-group-item list-group-item-action home-list-item d-flex justify-content-between align-items-center">
                <div>
                    <h2>Climate</h2>
                    <div>@ClimateStatusText</div>
                </div>
                <a href="/climate" class="stretched-link"></a>
                @((MarkupString)ChevronRightSvg)
            </li>
            @if (_selectedVehicle!.VehicleConfig.IsEV)
            {
                <li class="list-group-item list-group-item-action home-list-item d-flex justify-content-between align-items-center">
                    <div>
                        <h2>Charging</h2>
                        <div>@ChargingListStatusText</div>
                    </div>
                    <a href="/Charging" class="stretched-link"></a>
                    @((MarkupString)ChevronRightSvg)
                </li>
            }
            <li class="list-group-item list-group-item-action home-list-item d-flex justify-content-between align-items-center">
                <div>
                    <h2>Tires</h2>
                    <div class="@(HasTirePressureProblem ? "text-danger" : "")">@TireStatusText</div>
                </div>
                <a href="/Tires" class="stretched-link"></a>
                @((MarkupString)ChevronRightSvg)
            </li>
            <li class="list-group-item list-group-item-action home-list-item d-flex justify-content-between align-items-center">
                <div>
                    <h2>Other Controls</h2>
                </div>
                <a href="/Other" class="stretched-link"></a>
                @((MarkupString)ChevronRightSvg)
            </li>
            @if (_selectedVehicle.VehicleConfig.IsEV)
            {
                <li class="list-group-item list-group-item-action home-list-item d-flex justify-content-between align-items-center">
                    <div>
                        <h2>Configure</h2>
                    </div>
                    <a href="/Configure" class="stretched-link"></a>
                    @((MarkupString)ChevronRightSvg)
                </li>
            }
        </ul>

        <p class="mt-5">
            @_selectedVehicle.VehicleConfig.Odometer miles<br/>
            VIN: @_selectedVehicle.VehicleConfig.Vin
        </p>
    }
    else if (_error is not null)
    {
        <p>@_error</p>
    }
}

@code {
    private const string ArrowClockwiseSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/></svg>""";

    private const string ChevronRightSvg =
        """<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/></svg>""";

    private Vehicle? _selectedVehicle;
    private Status? _status;
    private string? _error;
    private bool _isLoading;
    private bool _dropdownOpen;
    private bool _isChildBusy;

    private string ChargingListStatusText
    {
        get
        {
            if (_status is null || !(_status.DriveTrain.IsCharging ?? false))
            {
                return string.Empty;
            }

            var limit = _status.DriveTrain.PluggedTo == EvPlugType.Fast
                ? _status.DriveTrain.ChargeLimitDc
                : _status.DriveTrain.ChargeLimitAc;
            var power = _status.DriveTrain.ChargingPowerKw;
            if (limit is null || power is null)
            {
                return string.Empty;
            }

            return $"Charging to {limit:0}% at {power:0.#} kW";
        }
    }

    private string ClimateStatusText
    {
        get
        {
            if (_status is null)
            {
                return string.Empty;
            }

            if (!_status.Climate.Temperature.IsOn)
            {
                return "Off";
            }

            var unitSuffix = _status.Climate.Temperature.Unit == TemperatureUnit.Fahrenheit ? "F" : "C";
            return $"On: {_status.Climate.Temperature.Temperature:0}°{unitSuffix}";
        }
    }

    private bool HasTirePressureProblem
    {
        get
        {
            if (_status is null)
            {
                return false;
            }

            var lamp = _status.DriveTrain.TirePressureWarningLamp;
            return lamp.FrontLeft || lamp.FrontRight || lamp.RearLeft || lamp.RearRight || lamp.All;
        }
    }

    private string TireStatusText => HasTirePressureProblem ? "Low pressure" : "Normal";

    protected override async Task OnInitializedAsync()
    {
        StateService.Resumed += HandleResumed;

        if (StateService.SelectedVehicle is not null && StateService.CachedStatus is not null)
        {
            _selectedVehicle = StateService.SelectedVehicle;
            _status = StateService.CachedStatus;
            return;
        }

        var vehicle = StateService.Vehicles.FirstOrDefault();
        if (vehicle is null)
        {
            return;
        }

        await SelectVehicleAsync(vehicle);
    }

    private void ToggleDropdown()
    {
        _dropdownOpen = !_dropdownOpen;
    }

    /// <summary>Re-fetches the vehicle list and the currently selected vehicle's status — the same refresh
    /// <see cref="StateService.ResumeAsync"/> performs when the app comes back from the background.</summary>
    private Task RefreshAsync() => StateService.ResumeAsync();

    private void HandleResumed()
    {
        InvokeAsync(RefreshStatusAsync);
    }

    private async Task SelectVehicleAsync(Vehicle vehicle)
    {
        _selectedVehicle = vehicle;
        StateService.SelectedVehicle = vehicle;
        _dropdownOpen = false;
        await RefreshStatusAsync();
    }

    private async Task RefreshStatusAsync()
    {
        if (_selectedVehicle is null)
        {
            return;
        }

        _isLoading = true;
        _error = null;
        _status = null;
        StateHasChanged();

        var result = await _selectedVehicle.StatusAsync();
        if (result.IsSuccessful)
        {
            _status = result.Data;
            StateService.CachedStatus = _status;
        }
        else
        {
            _error = "Could not load vehicle status.";
        }

        _isLoading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        StateService.Resumed -= HandleResumed;
    }
}
